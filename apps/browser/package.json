{
  "name": "passwordvault-browser",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "release:local": "node scripts/release-local.mjs",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "vite build && node scripts/package.mjs",
    "test": "tsc src/storage.ts --outDir test-build --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "preact": "10.27.2"
  },
  "devDependencies": {
    "@types/chrome": "0.1.24",
    "fake-indexeddb": "^6.2.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
