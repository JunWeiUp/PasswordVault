<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- App Icon Background -->
    <mxCell id="final_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#448AFF;strokeColor=none;arcSize=20;" vertex="1" parent="1">
      <mxGeometry x="300" y="100" width="200" height="200" as="geometry"/>
    </mxCell>

    <!-- Refined Padlock -->
    <!-- Shackle (U-shape) -->
    <mxCell id="final_shackle" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.arc;startAngle=0.5;endAngle=0;fillColor=none;strokeColor=#FFFFFF;strokeWidth=12;" vertex="1" parent="1">
      <mxGeometry x="350" y="130" width="100" height="120" as="geometry"/>
    </mxCell>
    
    <!-- Lock Body -->
    <mxCell id="final_body" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="340" y="190" width="120" height="80" as="geometry"/>
    </mxCell>
    
    <!-- Password Dots inside body (Accent Blue) -->
    <mxCell id="dot1" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#448AFF;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="355" y="220" width="15" height="15" as="geometry"/>
    </mxCell>
    <mxCell id="dot2" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#448AFF;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="382" y="220" width="15" height="15" as="geometry"/>
    </mxCell>
    <mxCell id="dot3" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#448AFF;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="408" y="220" width="15" height="15" as="geometry"/>
    </mxCell>
    <mxCell id="dot4" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#448AFF;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="435" y="220" width="15" height="15" as="geometry"/>
    </mxCell>

    <!-- Label -->
    <mxCell id="final_label" value="PassGuard Logo" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#448AFF;" vertex="1" parent="1">
      <mxGeometry x="300" y="320" width="200" height="40" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>