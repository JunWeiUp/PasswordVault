      "notes": "Returns mesh status {enabled,mode:'mesh',group,device,peers,pending,conflictCount,noteConflicts,remoteAssetCount,skew,migratedFrom,archivedConflicts} when mesh is enabled"
    },
    "relay-trust": {
      "group": "relay",
      "lock": "unlocked",
      "params": {
        "peer": "string"
      },
      "result": "{ok:true}"
    },
