        "expectedLibrary": "string",
        "founderKey": "string",
        "sender?": "string"
      },
      "result": "PeerResult|{ok:true,partial:true}",
      "notes": "envelope {packet,files}; envelope.protocol 'peer-v2-chunk' requires sender and is reassembled; Blocked (DevicesSyncBlocked) when formatVersion>=7"
