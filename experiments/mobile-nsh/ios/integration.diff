diff --git a/apps/ios/UITests/WalletCodesFlowTests.swift b/apps/ios/UITests/WalletCodesFlowTests.swift
index cbeca29..5ada21b 100644
--- a/apps/ios/UITests/WalletCodesFlowTests.swift
+++ b/apps/ios/UITests/WalletCodesFlowTests.swift
@@ -21,15 +21,17 @@ final class WalletCodesFlowTests: XCTestCase {
 
     // A code imported from a fictional setup link shows its live value in the list.
     app.tabBars.buttons["验证码"].tap()
-    app.buttons["新建"].tap()
-    app.buttons["新建条目"].tap()
+    app.buttons["新建"].tap()  // the NSH codes tab opens the editor directly
     let link = app.textFields["otpauth://…"]
     XCTAssertTrue(link.waitForExistence(timeout: 5))
     link.tap()
     link.typeText("otpauth://totp/Example:alex@example.test?secret=JBSWY3DPEHPK3PXP&issuer=Example")
     app.buttons["导入设置链接"].tap()
+    // Importing the link is asynchronous; Save enables once the title is filled in.
+    XCTAssertTrue(waitFor(app.buttons["保存"], "isEnabled == true"))
     app.buttons["保存"].tap()
-    let code = app.descendants(matching: .any)["code.row"].firstMatch
+    // The codes list is the shared NSH page; its rows carry `code-<item id>` identifiers.
+    let code = app.descendants(matching: .any).matching(NSPredicate(format: "identifier BEGINSWITH 'code-'")).firstMatch
     XCTAssertTrue(code.waitForExistence(timeout: 10))
     XCTAssertTrue(waitFor(code, "value MATCHES '[0-9]{6}'"), "The list shows the current six-digit code")
     attach(app, "codes-list")
